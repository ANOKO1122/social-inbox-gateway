# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- Docker Compose (docker-compose.yml) ---
# Use a URL-safe value (e.g. `openssl rand -hex 24`): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Required by Compose for POST /api/events/:id/replies. Unset in the process means that route returns 401.
INTERNAL_API_TOKEN=
# Optional Graph version. Default v23.0.
# META_GRAPH_VERSION=v23.0
# Optional JSON object of channel_id -> non-empty access token. Unset means {}.
# META_CHANNEL_TOKENS={"PAGE_ID":"token"}
# Connect page. Set all four, or none. The redirect URI must be registered on the Facebook app.
META_APP_ID=
META_OAUTH_REDIRECT_URI=https://inbox.example.com/inbox/connect/facebook/callback
# 32-byte key, hex (openssl rand -hex 32). Encrypts stored user and page tokens.
META_TOKEN_KEY=
# Page password, 16–128 characters. Not the Facebook password.
CONNECT_PASSWORD=
# DingTalk login. OAuth uses the client id and secret. The app id is only a record.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_APP_ID=
# Optional reply drafts. Set both, or neither. Use a reachable Dify Workflow API base URL.
# DIFY_API_BASE=https://dify.example.com/v1
# For Dify on the same host, see docker-compose.dify.yml and use http://nginx/v1.
# DIFY_API_KEY=app-
# Optional separate rule-review workflow, for previews and enabled rules; same DIFY_API_BASE.
# RULE_AI_API_KEY=app-

# --- Local development only (compose assembles DATABASE_URL itself) ---
PORT=4010
# Bind address; default 127.0.0.1. Compose sets 0.0.0.0 inside the container only.
# HOST=127.0.0.1
DATABASE_URL=
# TEST_DATABASE_URL=   # optional: enables the PostgreSQL integration tests
