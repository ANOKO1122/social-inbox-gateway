{
  "name": "social-inbox-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "sh scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "prebuild": "rm -rf dist",
