    "postbuild": "node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate-cli.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
